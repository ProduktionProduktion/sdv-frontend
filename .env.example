# Your WordPress site URL
NEXT_PUBLIC_WORDPRESS_URL='http://www.backend-domain.com'

# Public URL of this frontend (canonical/og:url and sitemap)
NEXT_PUBLIC_SITE_URL='http://www.frontend-domain.com'
 
# Plugin secret found in WordPress Settings->Faust
FAUST_SECRET_KEY='xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx'

# Revalidation secret used by WordPress to trigger revalidation of pages on the frontend.
REVALIDATE_SECRET='xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx'

# Where to but the output of `npm run build:cms`
CMS_COMPONENTS_THEME_PATH='/path/to/wordpress/wp-content/themes/headless/'
CMS_COMPONENTS_OUTPUT_PATH="${CMS_COMPONENTS_THEME_PATH}path-to-frontend-assets"
CMS_GRAPHQL_OUTPUT_PATH="${CMS_COMPONENTS_THEME_PATH}path-to-frontend-assets"
